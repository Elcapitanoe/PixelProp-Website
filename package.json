{
  "name": "pixelprop-website",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:css": "tailwindcss -i ./input.css -o ./style.css --watch",
    "build:css": "tailwindcss -i ./input.css -o ./style.css --minify",
    "build": "npm run build:css && vite build && node scripts/copy-static-assets.mjs",
    "preview": "vite preview",
    "deploy:vercel": "vercel --prod",
    "deploy:netlify": "netlify deploy --prod",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist",
    "test": "node --test"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.18",
    "vite": "^7.1.7"
  },
  "description": "Static Pixel Prop website with GitHub release metadata, checksums, guides, and changelogs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elcapitanoe/PixelProp-Website.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Elcapitanoe/PixelProp-Website/issues"
  },
  "homepage": "https://github.com/Elcapitanoe/PixelProp-Website#readme"
}
